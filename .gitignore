# Arquivos gerados pelo Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Ambiente virtual
.venv

# Variáveis de ambiente (podem ter senhas). Um .env.example sem segredos pode ser versionado.
.env
.env.*
!.env.example

# Cache de ferramentas (ruff, pytest, mypy, cobertura de testes)
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Banco SQLite de desenvolvimento, inclusive os arquivos temporários que ele cria ao lado
/scripts/exemplos/
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Arquivos de sistema operacional e editores
.DS_Store
.idea/


